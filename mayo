    },
}


class Fail(Exception):
    def __init__(self, msg, code=EX_ERR, detail=None):
        super().__init__(msg)
        self.msg, self.code, self.detail = msg, code, detail


# -------------------------------------------------------------------- state

def load_state():
    if os.environ.get("MAYO_COOKIE"):
        return {"cookie": os.environ["MAYO_COOKIE"], "source": "env"}
    try:
        with open(STATE_FILE, encoding="utf-8") as fh:
            st = json.load(fh)
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as exc:
        raise Fail(f"state file unreadable: {exc}")
    st["source"] = "file"
    return st


def save_state(st):
    if st.get("source") == "env":
        return
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump({k: v for k, v in st.items() if k != "source"}, fh, ensure_ascii=False, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, STATE_FILE)


def jwt_exp(token):
    try:
        part = token.split(".")[1]
        return json.loads(base64.urlsafe_b64decode(part + "=" * (-len(part) % 4)))["exp"]
    except (IndexError, KeyError, ValueError):
        return 0


# ---------------------------------------------------------------- transport

class Client:
    def __init__(self, state, debug=False, timeout=20):
        self.state, self.debug, self.timeout = state, debug, timeout
        self.jar = http.cookiejar.CookieJar()
        self.opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(self.jar))

    def _send(self, method, url, body=None, form=None, headers=None, data=None):
        h = {"User-Agent": UA, "Accept": "application/json", **(headers or {})}
        if form is not None:
            data = urllib.parse.urlencode(form).encode()
            h["Content-Type"] = "application/x-www-form-urlencoded; charset=UTF-8"
        elif body is not None:
            data = json.dumps(body, ensure_ascii=False).encode()
            h["Content-Type"] = "application/json"
        if self.debug:
            print(f"[debug] {method} {url}", file=sys.stderr)
            if body is not None:
                print(f"[debug] body {json.dumps(body, ensure_ascii=False)}", file=sys.stderr)
        req = urllib.request.Request(url, data=data, headers=h, method=method)
        try:
            with self.opener.open(req, timeout=self.timeout) as resp:
                raw, status = resp.read(), resp.status
        except urllib.error.HTTPError as exc:
            raw, status = exc.read(), exc.code
        except urllib.error.URLError as exc:
            raise Fail(f"network error: {exc.reason}", EX_NET)
        except TimeoutError:
            raise Fail("request timed out", EX_NET)
        text = raw.decode("utf-8-sig", "replace")
        if self.debug:
            print(f"[debug] HTTP {status} {text[:800]}", file=sys.stderr)
        return status, text

    # --- auth

    def _exchange(self, form):
        """POST /Token, then trade its one-time code for the session cookie."""
        status, text = self._send("POST", AUTH + "/Token", form=form)
        try:
            tok = json.loads(text)
        except ValueError:
            raise Fail(f"login: non-JSON response (HTTP {status})", EX_AUTH, {"body": text[:500]})
        if status >= 400 or not tok.get("code"):
            msg = tok.get("error_description") or tok.get("error") or f"HTTP {status}"
            raise Fail(f"login failed: {msg}", EX_AUTH, {"body": tok})
        self._send("GET", AUTHCOMMON + "/auth/checkticket?code=" + urllib.parse.quote(tok["code"]))
        cookie = next((c.value for c in self.jar if c.name == COOKIE), None)
        if not cookie:
            raise Fail("login: checkticket did not set the session cookie", EX_AUTH)
        self.state.update(cookie=cookie, refresh_token=tok.get("refresh_token"),
                          refresh_expire=tok.get("refresh_expire"), user=tok.get("userName"))
        save_state(self.state)
        return tok

    def login(self, user, password):
        _, html = self._send("GET", AUTH + "/HRM/Account/Login", headers={"Accept": "text/html"})
        m = re.search(r'name="__RequestVerificationToken"[^>]*value="([^"]+)"', html)
        if not m:
            raise Fail("login page changed: no __RequestVerificationToken", EX_ERR)
        return self._exchange({
            "__RequestVerificationToken": m.group(1), "grant_type": "password",
            "locale": "zh-tw", "password": password, "red": WEB + "/tube",
            "userName": user, "userStatus": "1"})

    def refresh(self):
        rt = self.state.get("refresh_token")
        if not rt:
            return False
        try:
            self._exchange({"grant_type": "refresh_token", "refresh_token": rt})
        except Fail:
            return False
        return True

    # --- api

    def call(self, method, path, body=None, data=None, headers=None, full=False, _retried=False):
        if not self.state.get("cookie"):
            raise Fail("not logged in - run `mayo login`", EX_AUTH)
        # ponytail: refresh a day early off the JWT exp; no clock-skew handling.
        if not _retried and jwt_exp(self.state["cookie"]) < _dt.datetime.now().timestamp() + 86400:
            self.refresh()
        url = path if path.startswith("http") else BACKEND + "/" + path.lstrip("/")
        status, text = self._send(method, url, body=body, data=data, headers={
            "Cookie": f"{COOKIE}={self.state['cookie']}", "Origin": WEB, "Referer": WEB + "/ta",
            "Accept-Language": "zh-tw", **(headers or {})})
        if status in (401, 403):
            if not _retried and self.refresh():
                return self.call(method, path, body, data, headers, full, _retried=True)
            raise Fail("session expired - run `mayo login`", EX_AUTH, {"http": status, "body": text[:500]})
        try:
            data = json.loads(text) if text.strip() else {}
        except ValueError:
            raise Fail(f"non-JSON response (HTTP {status})", EX_ERR, {"http": status, "body": text[:2000]})
        if status >= 400:
            d = data if isinstance(data, dict) else {}
            err = d.get("Error") if isinstance(d.get("Error"), dict) else {}
            note = err.get("Title") or err.get("Detail") or d.get("Message")
            raise Fail(f"{note or 'request failed'} (http {status})", EX_ERR, {"http": status, "body": data})
        if full or not isinstance(data, dict):
            return data
        return data.get("Data", data)


# ------------------------------------------------------------------- output

def warn(msg):
    print(msg, file=sys.stderr)


def emit(args, data, human=None):
    if args.json:
        print(json.dumps({"ok": True, "data": data}, ensure_ascii=False, indent=2))
    elif human is not None:
        print(human() if callable(human) else human)
    else:
        print(json.dumps(data, ensure_ascii=False, indent=2))


def local(iso):
    return _dt.datetime.fromisoformat(iso).astimezone() if iso else None


def hhmm(iso):
    t = local(iso)
    return t.strftime("%H:%M") if t else "-"


def next_actions(pt):
    """Which AttendanceTypes the web dialog would offer right now."""
    out = []
    wt, rt = pt.get("WorkType"), pt.get("RestType")
    if wt in (1, 2):
        out.append(wt)
        if rt in (1, 2):
            out.append(4 + rt)
    return out


def needs_reason(kind, rule, now):
    """Mirror checkTimeNormal(): early 上班 / late 下班 outside the allowed window
    needs an ExtendWorkHourType + reason. Returns 'AdvanceWork', 'PostponeWork' or None."""
    on, off = local(rule.get("WorkOnTime")), local(rule.get("WorkOffTime"))
    if kind == 1 and on and rule.get("AdvanceWorkStatus"):
        if now < on - _dt.timedelta(minutes=rule.get("AdvanceWorkMinute") or 0):
            return "AdvanceWork"
    if kind == 2 and off and rule.get("PostponeWorkStatus"):
        if now > off + _dt.timedelta(minutes=rule.get("PostponeWorkMinute") or 0):
            return "PostponeWork"
    return None


# ----------------------------------------------------------------- commands

def cmd_login(args, client):
    user = args.user or input("account: ")
    password = sys.stdin.readline().rstrip("\n") if args.password_stdin else getpass.getpass("password: ")
    tok = client.login(user, password)
    return emit(args, {"user": tok.get("userName"), "refresh_expire": tok.get("refresh_expire")},
                f"logged in as {tok.get('userName')} (re-login needed only if unused until {tok.get('refresh_expire')})")


def cmd_logout(args, client):
    try:
        os.remove(STATE_FILE)
    except FileNotFoundError:
        pass
    return emit(args, {"logged_out": True}, "logged out")


def cmd_whoami(args, client):
    d = client.call("GET", "fd/api/userInfo")
    return emit(args, d, lambda: "  ".join(str(d.get(k)) for k in
                                           ("userName", "companyName")
                                           if d.get(k)) or json.dumps(d, ensure_ascii=False))


def cmd_status(args, client):
    pt = client.call("GET", "pt/api/checkin/punchedType")
    rule = client.call("GET", "pt/api/CheckInExtendWorkHourRule/GetWithReason")
    acts = next_actions(pt)
    data = {"punched_type": pt, "work_on": rule.get("WorkOnTime"), "work_off": rule.get("WorkOffTime"),
            "next": [k for k, v in PUNCH.items() if v in acts]}

    def human():
        nxt = " / ".join(f"{k} ({PUNCH_NAMES[PUNCH[k]]})" for k in data["next"]) or "nothing (done for today)"
        lines = [f"shift  {hhmm(rule.get('WorkOnTime'))} - {hhmm(rule.get('WorkOffTime'))}",
                 f"next   {nxt}"]
        if pt.get("ErrorMessage"):
            lines.append(f"note   {pt['ErrorMessage']}")
        return "\n".join(lines)
    return emit(args, data, human)


def cmd_punch(args, client):
    kind = PUNCH[args.kind]
    pt = client.call("GET", "pt/api/checkin/punchedType")
    if kind not in next_actions(pt):
        allowed = [k for k, v in PUNCH.items() if v in next_actions(pt)] or ["nothing"]
        raise Fail(f"cannot punch {args.kind} now; the web dialog offers: {', '.join(allowed)}"
                   + (f" ({pt['ErrorMessage']})" if pt.get("ErrorMessage") else ""), EX_USAGE, {"punched_type": pt})
    body = {"AttendanceType": kind}
    if kind in (1, 2):
        rule = client.call("GET", "pt/api/CheckInExtendWorkHourRule/GetWithReason")
        extend = needs_reason(kind, rule, _dt.datetime.now().astimezone())
        if extend:
            types = rule.get("AdvanceWorkReasonType" if extend == "AdvanceWork" else "PostponeWorkReasonType") or []
            if not args.reason:
                raise Fail(f"outside the {extend} window ({hhmm(rule.get('WorkOnTime'))}-{hhmm(rule.get('WorkOffTime'))}); "
                           f"pass --reason TEXT to file it as a personal reason", EX_USAGE, {"rule": rule})
            # The web UI defaults to the last reason type (其他) for free text.
            body.update(ExtendWorkHourType=extend, CheckInTimeoutType="Personal",
                        CheckInPersonalReasonTypeId=types[-1]["CheckInPersonalReasonTypeId"] if types else None,
                        CheckInPersonalReason=args.reason)
    if args.dry_run:
        return emit(args, {"dry_run": True, "body": body}, f"would POST checkIn/punch/web {json.dumps(body, ensure_ascii=False)}")
    d = client.call("POST", "pt/api/checkIn/punch/web", body=body)
    return emit(args, d, lambda: f"{PUNCH_NAMES.get(d.get('punchType'), args.kind)} "
                                 f"{local(d['punchDate']).strftime('%Y-%m-%d %H:%M') if d.get('punchDate') else ''} "
                                 f"{d.get('locationName') or ''}".strip())


def hours(minutes):
    h, m = divmod(int(minutes or 0), 60)
    return f"{h}h{m:02d}" if m else f"{h}h"


def cmd_leave_balance(args, client):
    rows = client.call("GET", "pt/api/IndividualLeaveTypes/Unused")

    def human():
        out = []
        for r in rows:
            exp = ", ".join(f"{hours(d['UnusedMinutes'])} until {d['ExpiryDate'].split('~')[-1]}" for d in r.get("Detail") or [])
            out.append(f"{r['LeaveName']}\t{r['LeaveCode']}\tleft {hours(r['AvailableTime'] - r['UsedMinutes'])}"
                       f"\tused {hours(r['UsedMinutes'])}\t{exp}")
        return "\n".join(out) or "(no leave types)"
    return emit(args, rows, human)


def cmd_leave_list(args, client):
    q = urllib.parse.urlencode({"pageNumber": 1, "pageSize": args.limit, "status": "",
                                "yearly": args.year or _dt.date.today().year})
    rows = client.call("GET", "pt/api/LeaveRequestForms?" + q)
    return emit(args, rows, lambda: "\n".join(
        f"{local(r['StartDatetime']):%Y-%m-%d %H:%M} - {local(r['EndDatetime']):%m-%d %H:%M}\t{r['LeaveName']}"
        f"\t{r['StatusName']}\t{r['LeaveRequestFormId']}" for r in rows) or "(no leave this year)")


def cmd_leave_apply(args, client):
    day = _dt.date.fromisoformat(args.date)
    last = _dt.date.fromisoformat(args.to) if args.to else day
    wd = urllib.parse.quote(_dt.datetime.combine(day, _dt.time(12)).astimezone().isoformat(timespec="seconds"))
    shift = client.call("GET", f"pt/api/IndividualLeaveTypes/WorkTime?WorkDay={wd}&employeeId=", full=True)["Meta"]

    def at(d, hm, fallback):
        t = _dt.time.fromisoformat(hm) if hm else local(fallback).time()
        return _dt.datetime.combine(d, t).astimezone()
    start = at(day, args.start, shift.get("WorkOnTime"))
    end = at(last, args.end, shift.get("WorkOffTime"))
    if end <= start:
        raise Fail("end must be after start", EX_USAGE)
    q = urllib.parse.urlencode({"StartTime": start.isoformat(timespec="seconds"),
                                "EndTime": end.isoformat(timespec="seconds"), "employeeId": ""})
    avail = client.call("GET", "pt/api/IndividualLeaveTypes/AvailableLeave?" + q, full=True)
    types = avail.get("Data") or []
    idx = next((i for i, t in enumerate(types) if args.type in (t["LeaveCode"], t["LeaveName"])), None)
    if idx is None:
        raise Fail(f"leave type {args.type!r} not available then; choose from: "
                   + ", ".join(f"{t['LeaveName']} ({t['LeaveCode']})" for t in types), EX_USAGE)
    lt, meta = types[idx], avail.get("Meta") or {}
    minutes = int(args.minutes or meta.get("WorkMinutes") or 0)
    if not minutes:
        raise Fail("no working minutes in that range (day off?); pass --minutes", EX_USAGE)
    if minutes > (lt.get("UnusedMinutes") or 0):
        warn(f"warning: asking {hours(minutes)} but only {hours(lt.get('UnusedMinutes'))} of {lt['LeaveName']} left")
    agent = args.agent or meta.get("AgentId") or shift.get("AgentId")
    names = {d["FormType"]: d["FormTypeName"] for d in client.call("GET", "pt/api/FormType/deputyFormTypes")}
    form = {
        "StartDatetime": start.isoformat(timespec="seconds"), "EndDatetime": end.isoformat(timespec="seconds"),
        "Reason": args.reason, "AgentId": agent, "IsTrack": False,
        "LeaveRequestFormDetails": [{"LeaveCode": lt["LeaveCode"], "LeaveMinutes": minutes, "Sort": idx + 2}],
        "isBehalf": False,
        "deputyFormTypes": [{"formTypeName": names.get(f, f), "formType": f, "checked": True}
                            for f in meta.get("DeputyFormTypes") or []] if agent else None,
        "isAgentSign": bool(agent) and meta.get("IsAgentSign", True) is not False,
    }
    summary = (f"{lt['LeaveName']} {start:%Y-%m-%d %H:%M} - {end:%Y-%m-%d %H:%M} ({hours(minutes)}), "
               f"agent {meta.get('AgentName') or agent}, reason: {args.reason}")
    if not args.yes:
        emit(args, {"submitted": False, "form": form}, f"preview: {summary}\nre-run with --yes to submit")
        return EX_OK
    boundary = "----mayo" + os.urandom(8).hex()
    body = (f"--{boundary}\r\nContent-Disposition: form-data; name=\"form\"\r\n\r\n"
            f"{json.dumps(form, ensure_ascii=False)}\r\n--{boundary}--\r\n").encode()
    d = client.call("POST", "pt/api/LeaveRequestForms", data=body,
                    headers={"Content-Type": f"multipart/form-data; boundary={boundary}"})
    return emit(args, {"submitted": True, "form": form, "response": d}, f"submitted: {summary}")


def cmd_api_map(args, client):
    return emit(args, API_MAP)


def cmd_raw(args, client):
    body = None
    if args.data:
        try:
            body = json.loads(sys.stdin.read() if args.data == "-" else args.data)
        except ValueError as exc:
            raise Fail(f"--data is not valid JSON: {exc}", EX_USAGE)
    return emit(args, client.call(args.method.upper(), args.path, body=body))


# ------------------------------------------------------------------- parser

GLOBAL_DEFAULTS = {"json": False, "debug": False, "timeout": 20}


def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="machine-readable JSON output")
    common.add_argument("--debug", action="store_true", default=argparse.SUPPRESS, help="dump requests to stderr")
    common.add_argument("--timeout", type=int, default=argparse.SUPPRESS)
    p = argparse.ArgumentParser(prog="mayo", parents=[common],
                                description="Agent-native CLI for MayoHR Apollo XE web punch.",
                                epilog="Exit codes: 0 ok, 1 error, 2 usage/not allowed now, 3 auth, 4 network.")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("login", parents=[common], help="log in with account + password (password is not stored)")
    sp.add_argument("--user")
    sp.add_argument("--password-stdin", action="store_true", help="read password from stdin")
    sp.set_defaults(fn=cmd_login)
    sub.add_parser("logout", parents=[common], help="drop the local session").set_defaults(fn=cmd_logout)
    sub.add_parser("whoami", parents=[common], help="current employee").set_defaults(fn=cmd_whoami)
    sub.add_parser("status", parents=[common], help="today's shift and which punch is next").set_defaults(fn=cmd_status)

    sp = sub.add_parser("punch", parents=[common], help="打卡: in 上班 / out 下班 / break 休息開始 / break-end 休息結束")
    sp.add_argument("kind", choices=list(PUNCH))
    sp.add_argument("--reason", help="personal reason, required for early in / late out outside the allowed window")
    sp.add_argument("--dry-run", action="store_true", help="print the request body, do not punch")
    sp.set_defaults(fn=cmd_punch)

    lp = sub.add_parser("leave", parents=[common], help="查假 / 請假").add_subparsers(dest="leave_cmd", required=True)
    lp.add_parser("balance", parents=[common], help="剩餘假別").set_defaults(fn=cmd_leave_balance)
    sp = lp.add_parser("list", parents=[common], help="請假紀錄")
    sp.add_argument("--year", type=int); sp.add_argument("--limit", type=int, default=50)
    sp.set_defaults(fn=cmd_leave_list)
    sp = lp.add_parser("apply", parents=[common], help="請假 (preview unless --yes)")
    sp.add_argument("type", help="leave name or code, e.g. 特休 / H1001 (see `mayo leave balance`)")
    sp.add_argument("--date", required=True, help="YYYY-MM-DD first day")
    sp.add_argument("--to", help="YYYY-MM-DD last day (default: same day)")
    sp.add_argument("--start", help="HH:MM (default: shift start)")
    sp.add_argument("--end", help="HH:MM (default: shift end)")
    sp.add_argument("--minutes", type=int, help="override leave minutes (default: working minutes in range)")
    sp.add_argument("--reason", required=True)
    sp.add_argument("--agent", help="agent EmployeeId (default: your configured 代理人)")
    sp.add_argument("--yes", action="store_true", help="actually submit")
    sp.set_defaults(fn=cmd_leave_apply)

    sub.add_parser("api-map", parents=[common], help="print the reverse-engineered endpoint map").set_defaults(fn=cmd_api_map)
    sp = sub.add_parser("raw", parents=[common], help="call any backend path, e.g. `mayo raw GET pt/api/GlobalConfigs`")
    sp.add_argument("method"); sp.add_argument("path")
    sp.add_argument("--data", help="JSON body, or - for stdin")
    sp.set_defaults(fn=cmd_raw)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    for k, v in GLOBAL_DEFAULTS.items():
        if not hasattr(args, k):
            setattr(args, k, v)
    try:
        rc = args.fn(args, Client(load_state(), debug=args.debug, timeout=args.timeout))
        return rc if isinstance(rc, int) else EX_OK
    except Fail as exc:
        if args.json:
            print(json.dumps({"ok": False, "error": {"message": exc.msg, "code": exc.code, "detail": exc.detail}},
                             ensure_ascii=False, indent=2))
        else:
            print(f"error: {exc.msg}", file=sys.stderr)
            if exc.detail and args.debug:
                print(json.dumps(exc.detail, ensure_ascii=False, indent=2), file=sys.stderr)
        return exc.code
    except (BrokenPipeError, KeyboardInterrupt):
        return EX_ERR


if __name__ == "__main__":
    sys.exit(main())
