        "GET  IndividualLeaveTypes/WorkTime?WorkDay=&employeeId=": "Meta {WorkOnTime, WorkOffTime, AgentId, IsAgentSign, DeputyFormTypes}",
        "GET  IndividualLeaveTypes/AvailableLeave?StartTime=&EndTime=&employeeId=": "Meta.WorkMinutes for the range; Data = leave types usable then",
