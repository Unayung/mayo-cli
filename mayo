        "POST checkIn/punch/web": "{AttendanceType: 1|2|5|6} -> Data {punchType, punchDate, locationName}",
        "POST checkIn/punch/web (outside window)": "+ ExtendWorkHourType AdvanceWork|PostponeWork, CheckInTimeoutType "
                                                   "Personal, CheckInPersonalReasonTypeId, CheckInPersonalReason",
        "GET  CheckInExtendWorkHourRule/GetWithReason": "today's WorkOnTime/WorkOffTime + Advance/Postpone window and reason types",
        "GET  EmployeeAttendanceSettings": "IsWebPunch, IsPositioning, ...",
        "GET  locations/EnableList": "punch locations",
    },
    "leave (base /backend/pt/api/)": {
